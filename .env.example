# Copy this file to backend/.env and replace the placeholders with your values.
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/shopkart
JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=development

# Required only to complete checkout in Razorpay Test Mode.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-your-test-mode-secret
